{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node"],
    "noEmit": true,
    "declaration": false,
    "sourceMap": false,
    "isolatedModules": true,
    "allowImportingTsExtensions": false
  },
  "include": ["src", "vite.config.ts"]
}
