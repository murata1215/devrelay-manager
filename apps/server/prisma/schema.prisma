generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 横断スレ本体。1つの Thread が複数リポジトリへの Dispatch を束ねる会話単位。
model Thread {
  id        String    @id @default(cuid())
  title     String
  ownerId   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  messages   Message[]
  dispatches Dispatch[]
}

/// スレッド内の会話ログ（1メッセージ=1行、更新は想定しない）。
model Message {
  id        String   @id @default(cuid())
  threadId  String
  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role      String // 'user' | 'manager'
  content   String
  createdAt DateTime @default(now())
  /// サイクル1.11 ③-3: doc/orchestrator-layer3-design.md §6 D3「選択値は Dispatch と
  /// Message に記録」に基づく加算列。orchestrator LLM 層が resolveTier/resolveModel で
  /// 決定した値を任意で記録する（旧行は null のまま。値は tier.ts / manager-settings.ts の
  /// 権威が唯一の正）。
  tier      String?
  model     String?

  dispatches Dispatch[]

  @@index([threadId])
}

/// per-repo ビルドへの参照＝監査の原子。
/// 権威データ（実 build・監査ログ）は core 側に残り、ここは参照（projectId/submissionId/buildId）とスレ文脈のみを持つ。
/// status 遷移は src/orchestrator/dispatch-state.ts の遷移表が唯一の権威。値は
/// 'draft' | 'submitting' | 'planning' | 'awaiting_approval' | 'stale' | 'approving' | 'building' | 'done' | 'failed' | 'stopped'
/// （doc/orchestrator-layer3-design.md §2 の10状態。'pending' は含まない）。
model Dispatch {
  id              String    @id @default(cuid())
  threadId        String
  thread          Thread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  messageId       String?
  message         Message?  @relation(fields: [messageId], references: [id])
  projectId       String
  instruction     String?
  submissionId    String?
  buildId         String?
  status          String    @default("draft")
  statusChangedAt DateTime  @default(now())
  statusReason    String?
  lastPolledAt    DateTime?
  devlogPath      String?
  /// サイクル1.19 S3: ゲート②承認時に人間が任意で残す自由記述（core の approve_implementation
  /// へ note として伝える。案B/案C 等の指定チャネル）。未指定時は null のまま。
  approveNote     String?
  /// サイクル1.21: claude↔codex の協議（council）を有効化して投入したかどうか。
  /// 既定 false（オプトイン、default OFF）。core の submit_instruction はまだ council を
  /// 受け取らないため、現時点では manager 側の記録・表示にのみ使う（doc/devlog 参照）。
  council         Boolean   @default(false)
  cost            Float?
  /// サイクル1.11 ③-3: doc/orchestrator-layer3-design.md §6 D3「選択値は Dispatch と
  /// Message に記録（監査・コスト按分のため）」に基づく加算列。orchestrator LLM 層
  /// （draft-sink.ts の DraftSink.createDraft）が draft 作成時にのみ書き込む。
  /// status とは独立な列であり、この列を書けることは遷移権限を意味しない
  /// （DraftSink には updateMany が存在しないため、以後の更新経路はここには無い）。
  tier            String?
  model           String?
  /// サイクル1.13 実LLM結線: orchestrator LLM 呼び出しの usage 記録（記録のみ。集計は非
  /// スコープ）。旧行は null のまま。status とは独立な列であり、この列を書けることは
  /// 遷移権限を意味しない（draft-sink.ts の DraftSink.createDraft が draft 作成時にのみ
  /// 書き込む。以後の更新経路はここには無い）。
  inputTokens     Int?
  outputTokens    Int?
  /// API が実際に使用したと申告したモデルID（要求値の model 列との突き合わせ用）。
  responseModel   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  /// サイクル1.28: チャット入力へのテキスト添付（フェーズ1）。リレーション列であり
  /// スカラー列ではないため #135（schema と serializeDispatch の一致検査）の対象外
  /// （dispatch-view.test.ts はモデル宣言名を機械的に集めて除外するよう一般化してある）。
  attachments     DispatchAttachment[]

  @@index([threadId])
  @@index([messageId])
  @@index([projectId])
  @@index([status, statusChangedAt])
}

/// サイクル1.28: チャット入力に添付されたテキストファイル（フェーズ1はテキストのみ、
/// 画像はフェーズ2）。core の submit_instruction の attachments パラメータへ「そのまま」
/// 載せるための保管庫であり、instruction 本文には一切展開しない（仕様5）。
/// base64 のまま持ち、dispatch-worker.ts が submit 直前にのみ読む（一覧 API では返さない
/// ＝4秒ポーリングする GET /threads/:id/dispatches に base64 本体を載せないため）。
model DispatchAttachment {
  id         String   @id @default(cuid())
  dispatchId String
  dispatch   Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  filename   String
  mimeType   String
  /// base64 エンコード済みの本体（core へ渡す content と同一形式）。
  content    String
  /// デコード後の生バイト数（上限判定・UI 表示に使う。core への送信時には含めない）。
  byteSize   Int
  /// 添付順（0始まり）。core へ渡す配列の順序を再現するために持つ。
  sortOrder  Int
  createdAt  DateTime @default(now())

  @@index([dispatchId])
}
