DATABASE_URL="postgresql://user:password@localhost:5432/devrelay_manager?schema=public"
# 既定 3100 はローカル開発用。本番は 9026（Caddy の TestFlight 自動生成設定がこのポートへ
# upstream する。Caddy 側はサイクル1.27で触らない）。
PORT=3100
HOST=0.0.0.0

# core の MCP サーバー（localhost 再利用）
CORE_MCP_URL="http://127.0.0.1:3005/mcp"
DEVRELAY_PAT="your-personal-access-token-here"

# orchestrate の実LLM呼び出し（サイクル1.13）。未設定なら orchestrate は 503 を返す
# （自動フォールバックはしない）。
ANTHROPIC_API_KEY="your-anthropic-api-key-here"

# 認証（層⑤、サイクル1.27）: core の AuthSession に相乗りする。
# core の GET /api/auth/me にトークンを転送し、得た userId をここで許可判定する。
CORE_BASE_URL="https://app.devrelay.io"
# カンマ区切りの core user id。空（未設定）は fail-closed（全ユーザー拒否）。
MANAGER_ALLOWED_USER_IDS=""
# on|off。off はローカル開発専用（本番のインターネット公開では絶対に使わないこと）。
MANAGER_AUTH_MODE=on

# CORS: 空なら @fastify/cors を登録しない（同一オリジン配信の本番はこれが既定）。
# ローカル開発（apps/web を別ポートの vite dev server で動かす場合）は次のように指定する。
# CORS_ORIGINS=http://localhost:5173
CORS_ORIGINS=""
