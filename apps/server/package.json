{
  "name": "@devrelay-manager/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20",
    "pnpm": ">=8"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:studio": "prisma studio",
    "migrate": "prisma migrate dev",
    "migrate:create": "prisma migrate dev --create-only",
    "smoke:core": "tsx scripts/smoke-core.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "sh -c 'files=$(find src -name \"*.test.ts\" | sort); [ -n \"$files\" ] || { echo \"no test files found\" >&2; exit 1; }; exec node --import tsx --test $files'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/static": "^7.0.4",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@prisma/client": "^5.8.0",
    "dotenv": "^16.3.1",
    "fastify": "^4.25.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "prisma": "^5.8.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.3"
  }
}
